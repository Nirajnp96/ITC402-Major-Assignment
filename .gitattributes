# Normalise line endings: store LF in the repository, regardless of whether
# contributors work on Windows (CRLF) or Linux/macOS (LF).
* text=auto eol=lf

# Source and text files
*.php  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binary files (never modified by Git)
*.png  binary
*.jpg  binary
*.ico  binary
